generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  outboundRequests OutboundRequest[]
}

model Motor {
  id              Int                @id @default(autoincrement())
  motorCode       String             @unique
  name            String
  model           String
  brand           String?
  snCode          String?
  batchNo         String?
  supplier        String?
  purchaseDate    DateTime?
  status          String             @default("draft")
  currentLocation String?
  remark          String?
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  photos          MotorPhoto[]
  transactions    MotorTransaction[]
  outboundRequests OutboundRequest[] @relation("AssignedMotor")
}

model OutboundRequest {
  id              Int       @id @default(autoincrement())
  requesterId     Int
  requester       User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  model           String
  targetPerson    String
  destination     String
  remark          String?
  status          String    @default("pending")
  assignedMotorId Int?
  assignedMotor   Motor?    @relation("AssignedMotor", fields: [assignedMotorId], references: [id], onDelete: SetNull)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewRemark    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MotorPhoto {
  id         Int      @id @default(autoincrement())
  motorId    Int
  motor      Motor    @relation(fields: [motorId], references: [id], onDelete: Cascade)
  photoPath  String
  photoType  String
  uploadedBy String
  uploadedAt DateTime @default(now())
}

model MotorTransaction {
  id              Int      @id @default(autoincrement())
  motorId         Int
  motor           Motor    @relation(fields: [motorId], references: [id], onDelete: Cascade)
  transactionType String
  operator        String
  targetPerson    String?
  location        String?
  purpose         String?
  remark          String?
  createdAt       DateTime @default(now())
}
