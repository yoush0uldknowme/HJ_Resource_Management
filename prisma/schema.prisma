generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int      @id @default(autoincrement())
  username             String   @unique
  passwordHash         String
  secondaryPasswordHash String? // 二级密码哈希（用于删除电机、删除日志等高危操作验证）
  role                 String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  outboundRequests OutboundRequest[]
  libraryDocuments LibraryDocument[]
}

model Motor {
  id              Int                @id @default(autoincrement())
  motorCode       String             @unique
  name            String
  model           String
  brand           String?
  snCode          String?
  batchNo         String?
  supplier        String?
  purchaseDate    DateTime?
  status          String             @default("draft")
  currentLocation String?
  remark          String?
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  photos          MotorPhoto[]
  transactions    MotorTransaction[]
  outboundRequests OutboundRequest[] @relation("AssignedMotor")
}

model OutboundRequest {
  id              Int       @id @default(autoincrement())
  requesterId     Int
  requester       User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  model           String
  quantity        Int       @default(1)
  executedCount   Int       @default(0)
  targetPerson    String
  destination     String
  remark          String?
  status          String    @default("pending")
  assignedMotorId Int?
  assignedMotor   Motor?    @relation("AssignedMotor", fields: [assignedMotorId], references: [id], onDelete: SetNull)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewRemark    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MotorPhoto {
  id         Int      @id @default(autoincrement())
  motorId    Int
  motor      Motor    @relation(fields: [motorId], references: [id], onDelete: Cascade)
  photoPath  String
  photoType  String
  uploadedBy String
  uploadedAt DateTime @default(now())
}

model MotorTransaction {
  id              Int      @id @default(autoincrement())
  motorId         Int?
  motor           Motor?   @relation(fields: [motorId], references: [id], onDelete: SetNull)
  transactionType String
  operator        String
  targetPerson    String?
  location        String?
  purpose         String?
  remark          String?
  deleted         Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
}

// ── 资料库 ──

model LibraryCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  parentId    Int?
  parent      LibraryCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    LibraryCategory[] @relation("CategoryTree")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  documents   LibraryDocument[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LibraryDocument {
  id               Int      @id @default(autoincrement())
  title            String
  description      String?
  originalFileName String
  storedFileName   String
  storagePath      String
  fileExtension    String
  mimeType         String
  fileSize         Int
  sha256           String
  categoryId       Int
  category         LibraryCategory @relation(fields: [categoryId], references: [id])
  visibility       String   @default("all_members")
  status           String   @default("active")
  uploaderId       Int
  uploader         User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  tags             LibraryDocumentTag[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archivedAt       DateTime?

  @@index([categoryId])
  @@index([uploaderId])
  @@index([status])
}

model LibraryTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  documents LibraryDocumentTag[]
  createdAt DateTime @default(now())
}

model LibraryDocumentTag {
  documentId Int
  tagId      Int
  document   LibraryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        LibraryTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

/// 审计日志：不加外键关联，资料或用户被删除后日志仍然保留
model LibraryAuditLog {
  id         Int      @id @default(autoincrement())
  documentId Int
  actorId    Int
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([actorId])
}
