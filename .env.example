# HJ 资源管理系统 — 环境配置
# 复制此文件为 .env 并填入实际值

# ── 数据库 ──
# SQLite 数据库文件路径（相对路径相对于 prisma/ 目录）
DATABASE_URL="file:./prod.db"

# ── 认证 ──
# JWT 签名密钥（至少32位随机字符串，切勿使用示例值）
# 生成方法：node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET="在此填入随机生成的64字节密钥"

# ── 服务器（可选，仅在 server.mjs 中使用） ──
# 监听端口，默认 4011
PORT=4011

# 监听地址，默认 0.0.0.0（所有网卡）
HOST=0.0.0.0

# ── HTTPS（可选） ──
# Ubuntu/Caddy 部署时由反向代理处理，无需设置
# Windows 自签证书部署：将证书放在 certs/ 目录下
# TLS_CERT=certs/cert.pem
# TLS_KEY=certs/key.pem
